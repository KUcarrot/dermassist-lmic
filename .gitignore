# ============================================================
# DermAssist LMIC - .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# ============================================================
# Project-specific: large files (DO NOT UPLOAD)
# ============================================================

# --- Datasets (download from Kaggle / ISIC Archive) ---
data/raw/
data/processed/
data/external/

# --- Trained models (use HuggingFace Hub instead) ---
models/vision/*.pth
models/rag_db/*.db
models/gemma/lora_adapter*/

# --- Evaluation outputs (regenerate by running scripts) ---
outputs/

# --- Gradio runtime ---
.gradio/

# --- Logs ---
logs/
*.log

# --- Temporary files ---
*.tmp
.cache/

# --- Diagnostic files (temporary) ---
requirements_actual.txt
requirements_lock.txt
requirements_freeze.txt

# --- OS ---
Thumbs.db

# --- Secrets (NEVER commit) ---
.env
secrets.json
*.key
*.pem

# ============================================================
# Auto-generated and one-time-use code
# ============================================================

# --- Auto-generated RAG metadata ---
models/rag_db/knowledge_base_guide.json

# --- Training scripts (one-time use, artifacts published separately) ---
src/dermassist/llm/train_lora.py

# --- RAG build folder (DB is the artifact, code is one-time setup) ---
src/dermassist/rag/

# --- Vision training/evaluation folder (one-time setup, .pth files are the artifacts) ---
src/dermassist/vision/
# Demo validation tool (personal local file only)
src/dermassist/evaluation/validate_demo.py
